# Minimal ubi9-micro image with shell + common utils removed (no package
# manager is available in ubi9-micro, so binaries are removed directly).
# All removals must happen in this single RUN: deleting /bin/sh would break any
# subsequent RUN instruction.
FROM registry.access.redhat.com/ubi9-micro@sha256:ff30602252a3e92706585c7c34cd3c74028eaac4ab815e6b19f8b27562bdd7e3

RUN rm -f /usr/bin/bash /usr/bin/sh /usr/bin/less /usr/bin/more /usr/bin/cat