# Minimal ubi9-micro image with the shell removed (no package manager is
# available in ubi9-micro, so binaries are removed directly).
# All removals must happen in this single RUN: deleting /bin/sh would break any
# subsequent RUN instruction.
FROM registry.access.redhat.com/ubi9-micro@sha256:f332c99eb8f798a8486821c91937f10ad64ee83d7e739303be2df051040918f6

RUN rm -f /usr/bin/bash /usr/bin/sh \
    && echo "hello" > /hello.txt