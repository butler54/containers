# OpenShell sandbox — SpecKit docs profile (documents, presentations & diagrams)
#
# Thin config layer on top of the pre-built base image.
# Adds draw.io libs dir and GWS config dir vs the standard SpecKit profile.
# Published as ghcr.io/butler54/openshell-sandbox-speckit-docs:latest (multi-arch).
#
# No user-specific config: git identity is injected at sandbox creation by
# sandboxctl, NOT baked here (see GIT_USER_NAME/GIT_USER_EMAIL override ARGs).

ARG BASE_IMAGE=ghcr.io/butler54/openshell-sandbox-base:latest
FROM ${BASE_IMAGE}

USER root

# Vertex AI — project ID injected at sandbox creation via post_launch_setup()
ENV CLAUDE_CODE_USE_VERTEX=1 \
    CLOUD_ML_REGION=global

# Git config: SSH signing. Identity left unset (injected by sandboxctl); optional ARGs.
ARG GIT_USER_NAME=""
ARG GIT_USER_EMAIL=""
RUN git config --system gpg.format ssh && \
    git config --system commit.gpgsign true && \
    git config --system user.signingkey /sandbox/.ssh/id_ed25519 && \
    { [ -z "$GIT_USER_NAME" ]  || git config --system user.name  "$GIT_USER_NAME"; } && \
    { [ -z "$GIT_USER_EMAIL" ] || git config --system user.email "$GIT_USER_EMAIL"; }

# Claude Code keybindings (no GSD in speckit-docs profile)
RUN printf '{"bindings":[{"key":"shift+enter","command":"newline"}]}' > /sandbox/.claude/keybindings.json

# SpecKit initialization marker (actual init happens per-project)
RUN mkdir -p /sandbox/.specify

# Docs-specific: GWS and draw.io config dirs
RUN mkdir -p /sandbox/.ssh /sandbox/.config/gcloud /sandbox/.config/gws \
        /sandbox/.drawio-libs && \
    chown -R sandbox:sandbox /sandbox

USER sandbox

ENTRYPOINT ["/bin/bash"]
