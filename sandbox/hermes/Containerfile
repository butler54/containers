# OpenShell sandbox — Hermes agent layer
#
# Thin agent layer on top of the pre-built base image: Hermes Agent
# (NousResearch) plus signal-cli on a JRE, for an always-on messaging agent
# sandbox deployed on the minilab OpenShift cluster (see minilab
# docs/hermes-agent.md). Follows the speckit-docs precedent: a thin layer
# that carries its own toolchain on top of the shared base.
#
# Published as ghcr.io/butler54/openshell-sandbox-hermes:latest (multi-arch:
# linux/amd64, linux/arm64).
#
# Version pins (bump via PR):
#   - eclipse-temurin:25-jre  — manifest-list digest pin (Dependabot docker
#     ecosystem bumps it; signal-cli requires JRE 25 and Ubuntu noble apt
#     tops out at openjdk-21, hence the Temurin copy instead of apt)
#   - HERMES_COMMIT            — exact hermes-agent release commit (v0.23.1)
#   - SIGNAL_CLI_VERSION/SHA256 — signal-cli release tarball (v0.14.10)
#
# Runtime layout:
#   /opt/hermes-pristine         — the finished hermes home as installed with
#                                  HERMES_HOME=/sandbox/.hermes (so every
#                                  recorded absolute install path points at
#                                  /sandbox/.hermes). Image-owned; version ==
#                                  image tag; upgrades are image rebuilds +
#                                  reseeding, not in-sandbox `hermes update`.
#   /sandbox/.hermes             — HERMES_HOME at runtime: hermes-seed copies
#                                  the pristine home here on first boot, so
#                                  recorded paths resolve AND state (config,
#                                  sessions, memory, skills) persists on the
#                                  sandbox workspace volume.
#   /opt/java/jre25              — Temurin JRE 25 (signal-cli runtime)
#   /sandbox/.local/share/signal-cli — linked-device trust store (persistent)
#
# No secrets or user-specific config in this image — Slack/Signal tokens and
# accounts are injected at sandbox creation time by the minilab deployment.

# Global-scope ARG: must precede ANY FROM to be usable in FROM lines (an ARG
# after a FROM is scoped to that stage only, and `FROM ${BASE_IMAGE}` then
# resolves empty — "no FROM statement found").
ARG BASE_IMAGE=ghcr.io/butler54/openshell-sandbox-base:latest

# JRE 25 build stage: copied out of the official Temurin image so buildah
# resolves the right arch from the multi-arch manifest automatically.
FROM eclipse-temurin:25-jre@sha256:a640968ae55027b322cedd5f8228b01a84baff0b9e9360e47601c6a111ba1699 AS jre25

FROM ${BASE_IMAGE}

USER root

# === JRE 25 (signal-cli's minimum) ===
COPY --from=jre25 /opt/java/openjdk /opt/java/jre25
ENV JAVA_HOME=/opt/java/jre25
ENV PATH="/opt/java/jre25/bin:${PATH}"

# === signal-cli v0.14.10 (sha256-verified release tarball) ===
ARG SIGNAL_CLI_VERSION=0.14.10
ARG SIGNAL_CLI_SHA256=706a57d9faae7525cf732936efdabf210146e3c83f9e8ae7e4e62f5946121c33
RUN curl -fsSL -o /tmp/signal-cli.tar.gz \
      "https://github.com/AsamK/signal-cli/releases/download/v${SIGNAL_CLI_VERSION}/signal-cli-${SIGNAL_CLI_VERSION}.tar.gz" \
    && echo "${SIGNAL_CLI_SHA256}  /tmp/signal-cli.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/signal-cli.tar.gz -C /opt \
    && ln -sf "/opt/signal-cli-${SIGNAL_CLI_VERSION}/bin/signal-cli" /usr/local/bin/signal-cli \
    && rm -f /tmp/signal-cli.tar.gz

# === Hermes Agent v0.23.1 (exact commit pin) ===
# Installed with HERMES_HOME=/sandbox/.hermes — the FINAL runtime location —
# so every absolute install-state path hermes records is valid after
# hermes-seed copies the pristine home there on first boot. The finished home
# is then moved to /opt/hermes-pristine (image-owned seed). HOME points at
# /tmp for the install so nothing else accumulates under /sandbox.
ARG HERMES_COMMIT=3b421578588243f920886e6fe79a6faa87ea026e
RUN mkdir -p /sandbox/.hermes && chown -R sandbox:sandbox /sandbox
USER sandbox
RUN env HOME=/tmp HERMES_HOME=/sandbox/.hermes curl -fsSL https://hermes-agent.nousresearch.com/install.sh -o /tmp/hermes-install.sh \
    && env HOME=/tmp HERMES_HOME=/sandbox/.hermes bash /tmp/hermes-install.sh --commit "${HERMES_COMMIT}" \
         --non-interactive --skip-browser --skip-computer-use \
    && rm -f /tmp/hermes-install.sh
USER root
# Move the finished home to the pristine seed location and restore an empty
# /sandbox for the runtime (the workspace mount covers it anyway).
#
# a+rX on the pristine tree: it is created by the build user (uid 998) with
# 0600 files, but OpenShift sandboxes run as an arbitrary uid (e.g.
# 1000870000) and hermes-seed's `cp -a /opt/hermes-pristine/. /sandbox/.hermes/`
# must be able to READ the sources. Without this the copy fails at read time
# (Permission denied) and `set -eu` in hermes-gateway-start kills the main
# process ~2min after Ready. a+rX grants read (+ traverse on directories) to
# every uid; no secrets live in this image — it is public on ghcr.io by design.
RUN mv /sandbox/.hermes /opt/hermes-pristine \
    && chmod -R a+rX /opt/hermes-pristine \
    && mkdir -p /sandbox/.local/share \
    && chown -R sandbox:sandbox /sandbox

# === Command shim + seed script + gateway start (the sandbox's command surface) ===
COPY hermes /usr/local/bin/hermes
COPY hermes-seed /usr/local/bin/hermes-seed
COPY hermes-gateway-start /usr/local/bin/hermes-gateway-start
RUN chmod 0755 /usr/local/bin/hermes /usr/local/bin/hermes-seed /usr/local/bin/hermes-gateway-start

USER sandbox

ENTRYPOINT ["/bin/bash"]
