#!/usr/bin/env bash
# Start the Hermes gateway inside an OpenShell sandbox (main process).
#
# Responsibilities:
#   1. Seed the persistent hermes home (/sandbox/.hermes) from the image's
#      pristine copy on first boot — hermes-seed (idempotent). All install
#      state paths recorded at build time point at /sandbox/.hermes, and
#      config/sessions/memory/skills persist across sandbox restarts.
#   2. Start the signal-cli daemon on loopback when a Signal account is
#      configured AND the linked-device trust store exists (device linking
#      is a separate one-time interactive step: `signal-cli link`).
#   3. exec the hermes gateway (replaces this shell; the sandbox lifecycle
#      owns restarts).
#
# Environment (injected by the minilab deployment at sandbox creation):
#   SIGNAL_ACCOUNT   — E.164 number of the linked Signal device
#   SIGNAL_HTTP_URL  — signal-cli daemon endpoint (default 127.0.0.1:8080)
set -euo pipefail

# The sandbox runtime overrides PATH (venv-first); restore the JRE path —
# signal-cli's wrapper resolves java via PATH/JAVA_HOME.
export PATH="/opt/java/jre25/bin:${PATH}"

/usr/local/bin/hermes-seed
export HERMES_HOME=/sandbox/.hermes
mkdir -p /sandbox/.hermes/logs

# --- signal-cli daemon (only when linked) ---
SIGNAL_DATA=/sandbox/.local/share/signal-cli
if [ -n "${SIGNAL_ACCOUNT:-}" ] && [ -d "$SIGNAL_DATA/data" ]; then
  SIGNAL_HTTP_URL="${SIGNAL_HTTP_URL:-http://127.0.0.1:8080}"
  SIGNAL_BIND="${SIGNAL_HTTP_URL#http://}"
  echo "starting signal-cli daemon for ${SIGNAL_ACCOUNT} on ${SIGNAL_BIND}"
  nohup signal-cli -u "$SIGNAL_ACCOUNT" daemon --http "$SIGNAL_BIND" \
    >> /sandbox/.hermes/logs/signal-cli.log 2>&1 &
  # Wait briefly for the daemon socket before hermes connects to it.
  for _ in $(seq 1 30); do
    curl -sf -o /dev/null "http://${SIGNAL_BIND}/v1/about" 2>/dev/null && break
    sleep 1
  done
elif [ -n "${SIGNAL_ACCOUNT:-}" ]; then
  echo "SIGNAL_ACCOUNT set but no linked device at ${SIGNAL_DATA}" \
    "(run 'signal-cli link -n HermesAgent' interactively first); starting hermes without Signal" \
    | tee -a /sandbox/.hermes/logs/signal-cli.log
fi

exec /sandbox/.hermes/hermes-agent/hermes gateway "$@"
