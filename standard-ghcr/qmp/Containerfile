# Build stage
FROM registry.access.redhat.com/hi/python:3.14-builder@sha256:43310539d1eed4877d0a6047c4050bbde1afb25ed2b42e7072e009f453c9dc93 AS builder
USER root
RUN python3 -m venv /opt/venv
# qmp-tui's console-script entry point is gated behind the "tui" extra
# (urwid/urwid-readline/Pygments); installing bare qemu.qmp leaves qmp-tui
# non-functional.
RUN /opt/venv/bin/pip install --no-cache-dir "qemu.qmp[tui]"
USER ${CONTAINER_DEFAULT_USER}

# Runtime stage
FROM registry.access.redhat.com/hi/python:3.14@sha256:7170d990bdfd6dead1e46b8e4035fb0c6470e7dc1cecca163cdd73fb59799cb9
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
