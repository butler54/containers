# Build stage
FROM registry.access.redhat.com/hi/python:3.15-builder@sha256:b34ad63d9935a5432cb91e5816df4ad1dce19a53b82c7f6e85dd3d7c5931e183 AS builder
USER root
RUN python3 -m venv /opt/venv
# qmp-tui's console-script entry point is gated behind the "tui" extra
# (urwid/urwid-readline/Pygments); installing bare qemu.qmp leaves qmp-tui
# non-functional.
RUN /opt/venv/bin/pip install --no-cache-dir "qemu.qmp[tui]"
USER ${CONTAINER_DEFAULT_USER}

# Runtime stage
FROM registry.access.redhat.com/hi/python:3.15@sha256:43702455c694e5dcf90a0706ea74619b875cac4e41965c0d57bfefb57ee243a2
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
