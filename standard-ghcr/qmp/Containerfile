# Build stage
FROM registry.access.redhat.com/hi/python:3.14-builder@sha256:41de0aeac368800a458d330b822cc08a0877a9fc7c574ec7fdaf5b180941941f AS builder
USER root
RUN python3 -m venv /opt/venv
# qmp-tui's console-script entry point is gated behind the "tui" extra
# (urwid/urwid-readline/Pygments); installing bare qemu.qmp leaves qmp-tui
# non-functional.
RUN /opt/venv/bin/pip install --no-cache-dir "qemu.qmp[tui]"
USER ${CONTAINER_DEFAULT_USER}

# Runtime stage
FROM registry.access.redhat.com/hi/python:3.14@sha256:1cd247723979d5c879a5c71398ee9b46eaf8b90009f57f7b654ad93a60165c59
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
