# Build stage
FROM registry.access.redhat.com/hi/python:3.15-builder@sha256:77f1f67f5bd7491393f7d78154344b21fa6b5b9694965a9d72594315447566e6 AS builder
USER root
RUN python3 -m venv /opt/venv
# qmp-tui's console-script entry point is gated behind the "tui" extra
# (urwid/urwid-readline/Pygments); installing bare qemu.qmp leaves qmp-tui
# non-functional.
RUN /opt/venv/bin/pip install --no-cache-dir "qemu.qmp[tui]"
USER ${CONTAINER_DEFAULT_USER}

# Runtime stage
FROM registry.access.redhat.com/hi/python:3.15@sha256:a8241403eb7003db09cd13f0e0e1aad672c3d0bad0a39cf36d2b3c7ee7b70879
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
