# Build stage
FROM registry.access.redhat.com/hi/python:3.14-builder@sha256:71cd34d1d3edaaff31f829717ed87543a10482127198fee5320d0f51af1994c6 AS builder
USER root
RUN python3 -m venv /opt/venv
# qmp-tui's console-script entry point is gated behind the "tui" extra
# (urwid/urwid-readline/Pygments); installing bare qemu.qmp leaves qmp-tui
# non-functional.
RUN /opt/venv/bin/pip install --no-cache-dir "qemu.qmp[tui]"
USER ${CONTAINER_DEFAULT_USER}

# Runtime stage
FROM registry.access.redhat.com/hi/python:3.14@sha256:7f530e803d55bb18e58c55ebae02e78720ad2171f8fc40c6f3d166f35aaa7388
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
