# Build stage
FROM registry.access.redhat.com/hi/python:3.15-builder@sha256:6722b7c488c8eeb3722f51bdc3c98062031f94913f117a1281c85723fd534442 AS builder
USER root
RUN python3 -m venv /opt/venv
# qmp-tui's console-script entry point is gated behind the "tui" extra
# (urwid/urwid-readline/Pygments); installing bare qemu.qmp leaves qmp-tui
# non-functional.
RUN /opt/venv/bin/pip install --no-cache-dir "qemu.qmp[tui]"
USER ${CONTAINER_DEFAULT_USER}

# Runtime stage
FROM registry.access.redhat.com/hi/python:3.15@sha256:02891196c7c07ca9bfddaaa74f11f8381ae4473d84533aac0552ec705a5f4116
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
